# --- Phase 0 ---
# Inside docker compose the database host is "db"; use "localhost" when running the API directly.
DATABASE_URL=postgresql+asyncpg://linkvault:linkvault@db:5432/linkvault
API_KEY=change-me

# --- Phase 1: Telegram bot ---
# Where the bot reaches the API when run outside Docker. docker compose sets http://api:8000.
API_BASE_URL=http://localhost:8000
# From @BotFather. The bot container exits with an error until this is set.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Messages from anyone else are logged and ignored.
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# --- Phase 2: enrichment worker ---
# Links the worker enriches at the same time.
PREVIEW_CONCURRENCY=5
# Seconds the worker waits before checking again when no link is due.
WORKER_POLL_SECONDS=5
# Where thumbnails are saved and served from (relative to backend/ when run outside Docker).
# docker compose sets /data/thumbnails, a volume shared by the api and worker containers.
THUMBNAIL_DIR=data/thumbnails

# --- Phase 3: WhatsApp import ---
# Imported links are enriched gently so a big backfill doesn't get rate-limited by X or
# Instagram: at most this many at once (on top of PREVIEW_CONCURRENCY for live links)…
IMPORT_PREVIEW_CONCURRENCY=2
# …and at least this many seconds between two fetches from the same site.
IMPORT_DOMAIN_DELAY_SECONDS=5

# --- Phase 4: dashboard (web) ---
# The dashboard reuses API_KEY above and calls the API server-side; docker compose points it
# at http://api:8000. Running it outside Docker (cd web && npm run dev), put API_KEY and
# API_BASE_URL=http://localhost:8000 in web/.env.local.

# --- Later phases (not read yet) ---
TAGGER=none            # none | ollama | api
OLLAMA_URL=http://host.docker.internal:11434
OBSIDIAN_VAULT_PATH=
